# =========================================================
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/
*.publishsettings

# =========================================================
# Databases - DO NOT COMMIT LOCAL DB FILES
# =========================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.ndf

# =========================================================
# Secrets / credentials - DO NOT COMMIT
# =========================================================
.env
.env.*
!.env.example

appsettings.Local.json
appsettings.Production.json
appsettings.*.local.json

*.pem
*.key
*.pfx
*.crt
*.cer
*.p12
*.jks

keyy
keyy.pub
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

kubeconfig*.yaml
kubeconfig*.yml
*kubeconfig*
*.kubeconfig

# =========================================================
# Docker / Kubernetes local override files
# =========================================================
docker-compose.override.yml
docker-compose.*.override.yml

*.local.yaml
*.local.yml
*-secret.yaml
*-secret.yml
secrets.yaml
secrets.yml

# Keep normal deployment manifests tracked
!deploy/kubernetes/*.yml
!deploy/kubernetes/*.yaml

# =========================================================
# Node / frontend tooling
# =========================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================================
# Python tooling, if used by scripts
# =========================================================
